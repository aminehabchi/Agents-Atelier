# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Your files: agents' instructions and every project's site, versions, uploads and screenshots (local data, can be large)
storage/*
!storage/.gitkeep
# The folder of earlier versions (imported into storage/ on the first start; delete it once you've checked the import)
work/

# Temporary files written during atomic saves
*.tmp

# Logs
*.log

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local settings (copy .env.example to .env). The example is committed, your .env is not.
.env
.env.*
!.env.example
