# Agents Atelier settings.
# Copy this file to .env and change what you need:   cp .env.example .env
# Every line is optional: leave a value empty (or delete the line) to use the default shown.
# Variables set in your shell win over this file, e.g.  PORT=9000 ./run.sh

# ---- Server -----------------------------------------------------------------
# Address and port the web app listens on. Keep 127.0.0.1 and put a reverse proxy (with HTTPS) in front to serve it publicly.
HOST=127.0.0.1
PORT=8001
# Extra host names allowed to reach the server, comma-separated (e.g. a name from /etc/hosts).
# localhost, 127.0.0.1 and [::1] are always allowed.
ATELIER_HOSTS=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# ---- Folders (relative paths start at the project root) ---------------------
# Where every file is kept: agents/<agent-uuid>/ (instructions) and works/<project-uuid>/ (site, versions, uploads,
# browser-check screenshots). Everything else (projects, chat, versions, stats, the list of files) is in Postgres.
STORAGE_DIR=storage
# The folder of earlier versions. Its projects are imported into STORAGE_DIR once; the folder itself is left unchanged.
ATELIER_WORK=work
# Where the agent files, shared rules and saved teams live.
ATELIER_AGENTS=agents

# ---- Claude Code ------------------------------------------------------------
# The Claude Code command (full path if it isn't on your PATH).
CLAUDE_BIN=claude
# Model for agents that don't pick one themselves: an alias (fable, opus, sonnet) or a full model id.
# Empty = your Claude Code default.
AGENT_MODEL=
# Seconds before a stuck agent is stopped.
AGENT_TIMEOUT=900
# Agents the Orchestrator may let work at the same time (e.g. Design System and Copywriter). 1 = one after another.
PARALLEL_AGENTS=3
# Who pays for the agents: user = every member adds their own Claude API key in their profile (nothing runs
# without one); server = everyone uses this machine's Claude Code login (a private install).
CLAUDE_KEYS=user
# Encrypts the members' API keys in the database. Empty = one is generated and kept in STORAGE_DIR/.secrets/.
# Make one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_SECRET=

# ---- Limits -----------------------------------------------------------------
# Largest request the server accepts, in MB (an image upload needs ~1.4x the image size).
MAX_BODY_MB=8
# Largest reference image, in MB.
MAX_IMAGE_MB=5
# Largest existing site (folder or .zip) a new project can start from, in MB.
MAX_SITE_IMPORT_MB=40
# Largest file the Code tab opens or saves, in KB.
MAX_EDIT_KB=500
# Versions kept per project (oldest are removed first).
MAX_VERSIONS=150
# Times the Critic may send work back to earlier agents in one run (0 = never).
REVIEW_ROUNDS=2
# Plan: "pro" (default) or "free". On free, the Critic reviews once and can't send work back (REVIEW_ROUNDS is ignored).
ATELIER_PLAN=pro
# Brand images (logo, photos) a project can be given when it is created.
MAX_ASSETS=12

# ---- Database (Postgres). Start it with: docker compose -f database/docker-compose.yaml up -d
DATABASE_URL=postgresql://atelier:atelier@127.0.0.1:5432/atelier

# ---- Accounts
# The account registered with this email becomes admin once it confirms its email.
ADMIN_EMAIL=
# Days a login stays valid.
SESSION_DAYS=30
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Minutes an email confirmation code stays valid.
CODE_MINUTES=15
# "Delete my account" deactivates it; it's deleted for good this many days later unless its owner logs in again.
ACCOUNT_DELETE_DAYS=30
# How often (seconds) the server deletes the accounts whose time is up.
ACCOUNT_PURGE_SECONDS=3600

# ---- Sign-up protection (per IP address). 0 = no limit.
# Behind a reverse proxy (nginx, Caddy…), set TRUST_PROXY=true so the visitor's real address is used.
TRUST_PROXY=false
SIGNUPS_PER_HOUR=5
LOGINS_PER_15_MIN=30
RESETS_PER_HOUR=10
# ---- Rate limits on the rest of the app, per member (or per address when logged out). 0 = no limit.
# Any API call, per minute.
API_REQUESTS_PER_MINUTE=600
# Runs that start agents (prompts, Continue, Start again, retries), per hour: each one spends money on a Claude key.
RUNS_PER_HOUR=60
# People invited to projects, share links created, comments through share links (per visitor address), PayPal checkouts.
INVITES_PER_HOUR=30
SHARE_LINKS_PER_HOUR=30
COMMENTS_PER_HOUR=30
CHECKOUTS_PER_HOUR=10
# Refuse throwaway inboxes (list in server/disposable_domains.txt). Extra domains: a file, one per line.
BLOCK_DISPOSABLE_EMAILS=true
DISPOSABLE_DOMAINS_FILE=

# ---- Real browser checks: the QA agent and the Critic get screenshots and errors from headless Chrome.
BROWSER_CHECKS=true
# Path or name of Chrome/Chromium. Empty = look for google-chrome or chromium.
CHROME_BIN=
# true inside a container (the Docker image sets it): Chrome's own sandbox can't start there, the container isolates it.
CHROME_NO_SANDBOX=false

# ---- Legal pages (/terms and /privacy): who runs this service. Fill these in before going public.
LEGAL_NAME=Agents Atelier
# Empty = ADMIN_EMAIL.
LEGAL_EMAIL=
LEGAL_ADDRESS=

# ---- Email (confirmation codes). Leave SMTP_HOST empty to print codes in the server log instead (local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agents Atelier <no-reply@example.com>
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Optional: also write every email to this file, one JSON object per line (handy for testing).
EMAIL_OUTBOX=
# Email whoever started a run when it ends after this many seconds and nobody has the studio open (0 = always).
RUN_EMAIL_AFTER=90

# ---- Online payment with PayPal subscriptions. Leave PAYPAL_CLIENT_ID empty to keep upgrades as requests an admin approves.
# 1. Create an app at https://developer.paypal.com (Apps & Credentials) and copy its client id and secret here.
# 2. Run  .venv/bin/python server/manage.py paypal-setup  : it creates the product and the Pro and Agency plans and
#    prints PAYPAL_PLAN_PRO and PAYPAL_PLAN_AGENCY.
# 3. In the app, add a webhook to  <PUBLIC_URL>/api/billing/paypal/webhook  with the BILLING.SUBSCRIPTION.* and
#    PAYMENT.SALE.* events, and copy its id into PAYPAL_WEBHOOK_ID. For paid marketplace agents (one-time payments,
#    70% to the creator) add CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.* too; they only need the client id and secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test money) or live
PAYPAL_MODE=sandbox
# Only to point at another PayPal API address (tests). Empty = PayPal's own for PAYPAL_MODE.
PAYPAL_API=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_AGENCY=
# Optional: the yearly plans (two months free), also printed by paypal-setup. Without them members pay monthly only.
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_AGENCY_YEARLY=
PAYPAL_WEBHOOK_ID=
# The address members use to reach the app, e.g. https://atelier.example.com. Empty = the address of each request.
PUBLIC_URL=

# ---- Log in with Google or GitHub. Each provider appears on the login and sign-up pages once both values are set.
# The callback address to register with each provider is  <PUBLIC_URL>/api/auth/oauth/google/callback  (or /github/).
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → OAuth Apps → New OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only for the tests (a fake provider). Leave empty.
GOOGLE_AUTH_URL=
GOOGLE_TOKEN_URL=
GOOGLE_USERINFO_URL=
GITHUB_AUTH_URL=
GITHUB_TOKEN_URL=
GITHUB_API_URL=

