# Agents Atelier settings.
# Copy this file to .env and change what you need:   cp .env.example .env
# Every line is optional: leave a value empty (or delete the line) to use the default shown.
# Variables set in your shell win over this file, e.g.  PORT=9000 ./run.sh

# ---- Server -----------------------------------------------------------------
# Address and port the web app listens on. Keep 127.0.0.1: the app has no login.
HOST=127.0.0.1
PORT=8001
# Extra host names allowed to reach the server, comma-separated (e.g. a name from /etc/hosts).
# localhost, 127.0.0.1 and [::1] are always allowed.
ATELIER_HOSTS=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# ---- Folders (relative paths start at the project root) ---------------------
# Where projects, chat history and versions are stored.
ATELIER_WORK=work
# Where the agent files, shared rules and saved teams live.
ATELIER_AGENTS=agents

# ---- Claude Code ------------------------------------------------------------
# The Claude Code command (full path if it isn't on your PATH).
CLAUDE_BIN=claude
# Model for agents that don't pick one themselves: an alias (fable, opus, sonnet) or a full model id.
# Empty = your Claude Code default.
AGENT_MODEL=
# Seconds before a stuck agent is stopped.
AGENT_TIMEOUT=900

# ---- Limits -----------------------------------------------------------------
# Largest request the server accepts, in MB (an image upload needs ~1.4x the image size).
MAX_BODY_MB=8
# Largest reference image, in MB.
MAX_IMAGE_MB=5
# Largest existing site (folder or .zip) a new project can start from, in MB.
MAX_SITE_IMPORT_MB=40
# Largest file the Code tab opens or saves, in KB.
MAX_EDIT_KB=500
# Versions kept per project (oldest are removed first).
MAX_VERSIONS=150
# Times the Critic may send work back to earlier agents in one run (0 = never).
REVIEW_ROUNDS=2
# Plan: "pro" (default) or "free". On free, the Critic reviews once and can't send work back (REVIEW_ROUNDS is ignored).
ATELIER_PLAN=pro
# Brand images (logo, photos) a project can be given when it is created.
MAX_ASSETS=12

# ---- Database (Postgres). Start it with: docker compose -f database/docker-compose.yaml up -d
DATABASE_URL=postgresql://atelier:atelier@127.0.0.1:5432/atelier

# ---- Accounts
# The account registered with this email becomes admin once it confirms its email.
ADMIN_EMAIL=
# Days a login stays valid.
SESSION_DAYS=30
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Minutes an email confirmation code stays valid.
CODE_MINUTES=15

# ---- Sign-up protection (per IP address). 0 = no limit.
# Behind a reverse proxy (nginx, Caddy…), set TRUST_PROXY=true so the visitor's real address is used.
TRUST_PROXY=false
SIGNUPS_PER_HOUR=5
LOGINS_PER_15_MIN=30
RESETS_PER_HOUR=10
# Refuse throwaway inboxes (list in server/disposable_domains.txt). Extra domains: a file, one per line.
BLOCK_DISPOSABLE_EMAILS=true
DISPOSABLE_DOMAINS_FILE=

# ---- Real browser checks: the QA agent and the Critic get screenshots and errors from headless Chrome.
BROWSER_CHECKS=true
# Path or name of Chrome/Chromium. Empty = look for google-chrome or chromium.
CHROME_BIN=

# ---- Legal pages (/terms and /privacy): who runs this service. Fill these in before going public.
LEGAL_NAME=
# Empty = ADMIN_EMAIL.
LEGAL_EMAIL=
LEGAL_ADDRESS=

# ---- Email (confirmation codes). Leave SMTP_HOST empty to print codes in the server log instead (local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agents Atelier <no-reply@example.com>
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Optional: also write every email to this file, one JSON object per line (handy for testing).
EMAIL_OUTBOX=
